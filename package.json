{
  "name": "bee-monorepo",
  "private": true,
  "description": "BEE — Sales Force Intelligence monorepo. Deploy the Next.js frontend from apps/web.",
  "scripts": {
    "build": "pnpm --dir apps/web build",
    "dev:web": "pnpm --dir apps/web dev",
    "lint:web": "pnpm --dir apps/web lint"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "ignoredBuiltDependencies": ["sharp", "unrs-resolver"]
  }
}
