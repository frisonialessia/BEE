# =============================================================================
# BEE Web — environment configuration template
# -----------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in real values. NEVER commit `.env.local`.
# Both variables are validated at startup by src/lib/env.ts (Zod schema) —
# an invalid or missing NEXT_PUBLIC_API_URL fails fast instead of surfacing as
# a confusing runtime fetch error.
#
# NEXT_PUBLIC_* variables are inlined into the client bundle at build time and
# are visible to anyone who opens the browser's dev tools — never put a secret
# here. NEXT_PUBLIC_BEE_API_KEY is the one exception BEE intentionally makes:
# it's a low-privilege key scoped to this dashboard's own API calls, matching
# apps/api's API_SECRET_KEY, not a credential that grants broader access.
# =============================================================================

# Base URL of the BEE API (apps/api). Defaults to http://localhost:8000 for
# local development against `docker compose up` / `make api-dev`.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Must match apps/api's API_SECRET_KEY when the backend has one configured
# (see apps/api/.env.example). Leave empty while the backend runs with
# API_SECRET_KEY unset (local development, auth disabled).
NEXT_PUBLIC_BEE_API_KEY=

# ----- Error monitoring (see src/instrumentation.ts + instrumentation-client.ts) --
# Optional. Unset (the default) means Sentry.init() is never called — zero
# error visibility, but also zero behavior change and no Sentry account
# needed to run this app. Get a DSN from sentry.io → Settings → Projects →
# your project → Client Keys (DSN). NEXT_PUBLIC_ because the DSN identifies
# where events go, not a secret — the browser bundle needs it too.
NEXT_PUBLIC_SENTRY_DSN=
# Optional, build-time only: readable (un-minified) stack traces in Sentry.
# Leave unset and the Sentry Next.js plugin just skips source-map upload —
# does not fail the build. Generate a token at
# sentry.io → Settings → Auth Tokens (needs project:releases scope).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ----- Product analytics (see src/providers/posthog-provider.tsx) -----------
# Optional. Unset (the default) means posthog-js is never initialized — zero
# usage telemetry, but also zero behavior change and no PostHog account
# needed to run this app. Get a project API key from posthog.com → Project
# Settings → Project API Key. NEXT_PUBLIC_ because, like the Sentry DSN
# above, this identifies where events go rather than granting write access
# to anything else.
NEXT_PUBLIC_POSTHOG_KEY=
# Defaults to PostHog's US cloud ("https://us.i.posthog.com") if unset. Use
# "https://eu.i.posthog.com" for an EU-hosted project, or a self-hosted URL.
NEXT_PUBLIC_POSTHOG_HOST=
