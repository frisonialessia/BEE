# =============================================================================
# BEE Web — environment configuration template
# -----------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in real values. NEVER commit `.env.local`.
# Both variables are validated at startup by src/lib/env.ts (Zod schema) —
# an invalid or missing NEXT_PUBLIC_API_URL fails fast instead of surfacing as
# a confusing runtime fetch error.
#
# NEXT_PUBLIC_* variables are inlined into the client bundle at build time and
# are visible to anyone who opens the browser's dev tools — never put a secret
# here. NEXT_PUBLIC_BEE_API_KEY is the one exception BEE intentionally makes:
# it's a low-privilege key scoped to this dashboard's own API calls, matching
# apps/api's API_SECRET_KEY, not a credential that grants broader access.
# =============================================================================

# Base URL of the BEE API (apps/api). Defaults to http://localhost:8000 for
# local development against `docker compose up` / `make api-dev`.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Must match apps/api's API_SECRET_KEY when the backend has one configured
# (see apps/api/.env.example). Leave empty while the backend runs with
# API_SECRET_KEY unset (local development, auth disabled).
NEXT_PUBLIC_BEE_API_KEY=
