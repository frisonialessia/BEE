{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/v1/internal/market-scan/tick",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/v1/internal/jobs/tick",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/v1/internal/digest/tick",
      "schedule": "0 * * * *"
    }
  ]
}
