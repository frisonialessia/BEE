# =============================================================================
# BEE API — environment configuration template
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# In production, inject these as real environment variables / secrets rather
# than shipping a file.
#
# Generate secrets:
#   python -c "import secrets; print(secrets.token_hex(32))"
# =============================================================================

# ----- Application -----------------------------------------------------------
PROJECT_NAME="BEE - Sales Force Intelligence"
ENVIRONMENT=local            # local | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1

# ----- Database (PostgreSQL) -------------------------------------------------
# Either provide a full DSN...
# DATABASE_URL=postgresql+psycopg://bee:bee@localhost:5432/bee
# ...or the discrete parts below (used when DATABASE_URL is empty):
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=bee
POSTGRES_PASSWORD=bee
POSTGRES_DB=bee

# On a serverless deployment (Vercel), DATABASE_URL should point at your
# Postgres provider's *pooled* connection string (PgBouncer/Neon's "-pooler"
# host/Supabase's transaction-mode port 6543), not the direct one — each
# warm function instance holds its own connection pool, and concurrent
# traffic can spin up many instances at once. DB_POOL_SIZE/DB_MAX_OVERFLOW
# below are already kept small for this reason; a pooled connection string
# is what actually makes that safe under real concurrent load.
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=3

# ----- Shared state (Redis, opt-in) -------------------------------------------
# See app.core.redis. Unset (the default) keeps every guard/rate limiter in
# this codebase process-local, exactly as they behave without this section —
# set this once the deployment runs more than one instance and those guards
# need to hold their quota across all of them.
# REDIS_URL=redis://localhost:6379/0

# ----- Secrets vault (AWS Secrets Manager, opt-in) ----------------------------
# See app.services.secret_manager. Default "env" keeps every credential
# resolved from environment variables, exactly as today. Set SECRET_BACKEND
# to move credential resolution to a single AWS Secrets Manager secret (a
# JSON object keyed by the same env-var names, e.g.
# {"LINKEDIN_ACCESS_TOKEN": "...", "SENDGRID_WEBHOOK_SECRET": "..."}), with
# environment variables still used as a fallback for any key not yet in it.
# SECRET_BACKEND=aws_secrets_manager
# AWS_SECRETS_MANAGER_SECRET_ID=bee/production/secrets
# AWS_REGION=us-east-1

# ----- Security — API Key ----------------------------------------------------
# When set, ALL REST endpoints (except /health and /ready) require:
#   X-API-Key: <value>
# Leave empty for local development (disables auth).
# In production: generate with `python -c "import secrets; print(secrets.token_hex(32))"`
# and store in your secret manager (Vercel Env, Doppler, AWS Secrets Manager).
API_SECRET_KEY=

# Comma-separated paths exempt from API key auth (always exempt: /, /api/v1/health, /api/v1/ready).
# /api/v1/webhooks/receive is exempt too by default — it authenticates via
# per-provider HMAC signatures instead (see WEBHOOK_SIGNING_SECRET and the
# provider *_WEBHOOK_SECRET vars below), which external providers can send but
# an X-API-Key header cannot be added to. If you override this value, keep
# that path in the list or inbound webhook ingestion will start requiring an
# API key it will never receive.
API_KEY_EXEMPT_PATHS=/api/v1/health,/api/v1/ready,/api/v1/webhooks/receive

# ----- Security — Multi-tenant user auth (Organization / Team / User) -------
# Distinct from API_SECRET_KEY above: that gates service-to-service calls with
# one shared secret. JWT_SECRET_KEY signs per-user session tokens issued at
# POST /api/v1/auth/login, carrying identity + role for org/team-scoped
# visibility (see app/services/permissions). Generate with the same command
# as WEBHOOK_SIGNING_SECRET below.
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080          # 7 days
PASSWORD_HASH_ROUNDS=12            # bcrypt work factor

# ----- Security — Webhook HMAC -----------------------------------------------
# Shared secret used to verify HMAC-SHA256 signatures on inbound webhooks.
# The app itself now defaults this to a random per-process value and
# WEBHOOK_SIGNATURE_REQUIRED to true (secure by default — nothing is accepted
# unless correctly signed). These two lines exist only to opt local dev back
# into the old permissive behavior; do NOT copy the literal secret value below
# into a real deployment — set both vars explicitly once you wire up a real
# provider webhook, matching whatever secret that provider signs with.
WEBHOOK_SIGNING_SECRET=change-me-in-production
WEBHOOK_SIGNATURE_REQUIRED=false

# How long (seconds) POST /webhooks/receive remembers an accepted
# (provider, signature) pair to reject an exact replay of that same request.
# 0 disables the check. Per-process only (see app.core.replay_guard).
WEBHOOK_REPLAY_WINDOW_SECONDS=300

# ----- Signup abuse protection (POST /auth/register) -------------------------
# Registration is open self-serve with no email verification. Set a shared
# code here during a controlled beta and distribute it out-of-band to
# invited testers — /auth/register then requires it. Leave unset for fully
# open registration (the default).
# SIGNUP_INVITE_CODE=change-me-to-a-real-beta-code

# Per-IP registration attempts allowed per rolling hour, independent of the
# invite code above. 0 disables the check.
SIGNUP_RATE_LIMIT_PER_HOUR=5

# ----- Login abuse protection (POST /auth/login) -----------------------------
# Per-IP login attempts allowed per rolling hour (successes count too, same
# as SIGNUP_RATE_LIMIT_PER_HOUR below). Deliberately per-IP, not per-email —
# see app.core.login_guard for why a per-account lock is its own abuse
# vector. Higher default than signup: login is routine, repeated traffic a
# shared office IP can generate. 0 disables the check.
LOGIN_RATE_LIMIT_PER_HOUR=20

# ----- General API rate limiting (see app.core.api_rate_limit_guard) --------
# Every flow above has its own dedicated, tighter guard — this is the
# backstop for the rest of the API (the broad CRUD surface, AI/analytics
# endpoints), which had no throttle at all before this existed. Per-IP
# requests allowed per rolling MINUTE (not hour). 0 disables the check.
API_RATE_LIMIT_PER_MINUTE=300
# Comma-separated, exact-or-prefix match. Health/ready and the two Vercel
# Cron tick endpoints are exempt — already authenticated a different way.
API_RATE_LIMIT_EXEMPT_PATHS=/api/v1/health,/api/v1/ready,/api/v1/internal/market-scan/tick,/api/v1/internal/jobs/tick

# ----- Forgot-password (POST /auth/forgot-password + /auth/reset-password) --
# Self-serve password recovery — sends a reset link by email (via
# EMAIL_SMTP_* below, or mock-logged if unconfigured). Independent of the
# internal support tool below, which is BEE-team-only.
# Per-IP reset-email requests allowed per rolling hour. 0 disables the check.
PASSWORD_RESET_RATE_LIMIT_PER_HOUR=5
# Minutes a reset link stays valid after being requested.
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60

# ----- Internal support tool (POST /internal/support/reset-password) --------
# Emergency-only: force-resets any user's password by email, for the BEE
# team, not customers. Unset (the default) → the endpoint 404s, doesn't
# exist. Keep this secret separate from API_SECRET_KEY/JWT_SECRET_KEY and
# give it to very few people — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# SUPPORT_ADMIN_SECRET=change-me-to-a-real-secret

# ----- Error monitoring (see app.main's create_app) -------------------------
# Unset (the default) means sentry_sdk.init() runs with dsn=None, which is
# sentry_sdk's own documented way to disable the SDK entirely — zero error
# visibility, but also zero behavior change and no Sentry account needed to
# run this app. Get a DSN from sentry.io → Settings → Projects → your
# project → Client Keys (DSN).
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# 0.0-1.0. Off by default — error capture doesn't need trace sampling, and
# turning this on has a real cost (Sentry bills per transaction).
SENTRY_TRACES_SAMPLE_RATE=0.0

# ----- Distributed tracing (see app.core.tracing) ---------------------------
# Unset (the default) means setup_tracing() is a no-op — the
# opentelemetry-* dependencies stay installed but never initialized. Point
# this at an OpenTelemetry Collector or a managed OTLP/gRPC endpoint.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# 0.0-1.0. Full sampling by default — unlike Sentry, nothing here is
# metered until spans leave the collector; turn down for a metered backend.
OTEL_TRACES_SAMPLE_RATE=1.0
# For a managed backend that needs auth (Honeycomb, Grafana Cloud, ...),
# set this too — the OTEL SDK reads it directly, no BEE-specific config:
# OTEL_EXPORTER_OTLP_HEADERS=x-honeycomb-team=<your-api-key>

# ----- Enterprise SSO (see app.services.sso) ---------------------------------
# All three unset (the default) means the SSO endpoints 404 rather than
# existing as a live auth surface — no WorkOS account needed to run this
# app. Get these from a WorkOS dashboard (dashboard.workos.com) once BEE
# actually has an enterprise customer asking for SSO. Also requires each
# customer organization's own sso_enabled/sso_connection_id/sso_domain to
# be set via PATCH /organizations/me/sso (OWNER only) — see that
# endpoint's own docstring.
# WORKOS_API_KEY=sk_example_...
# WORKOS_CLIENT_ID=client_example_...
# WORKOS_REDIRECT_URI=http://localhost:8000/api/v1/auth/sso/callback

# ----- Billing (see app.services.billing) ------------------------------------
# Scaffolding, not enforcement — see Organization.stripe_* fields' comment
# in app/models/organization.py for what that means. Both unset (the
# default) means the billing endpoints 404 rather than existing as a live
# surface, no Stripe account needed to run this app. Get these from a
# Stripe dashboard (dashboard.stripe.com → Developers) once BEE actually
# charges anyone.
# STRIPE_API_KEY=sk_test_...
# Get this after registering the webhook endpoint (.../api/v1/billing/webhook)
# in the Stripe dashboard — Stripe generates it, it's not something you pick.
# STRIPE_WEBHOOK_SECRET=whsec_...

# ----- MarketScanOrchestrator (proactive market scan, opt-in) ---------------
# CRON_SECRET must be this exact name — Vercel auto-injects
# `Authorization: Bearer $CRON_SECRET` on every Vercel Cron Job invocation
# when a project env var by this exact name is set (see
# apps/api/vercel.json's "crons" entry and
# app/api/v1/endpoints/internal_market_scan.py). Unset means the tick
# endpoint 404s — the scan simply never fires, same "off by default"
# convention as SUPPORT_ADMIN_SECRET above. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# CRON_SECRET=change-me-to-a-real-secret

# Separate from CRON_SECRET being set: this is the "do real work" switch —
# leave false to deploy and verify the cron wiring itself (ticks land in
# market_scan_logs as 0-company no-ops) before turning on real scanning.
MARKET_SCAN_ENABLED=false
MARKET_SCAN_BATCH_SIZE=20
MARKET_SCAN_INTERVAL_HOURS=24

# ----- AccountResearchAgent (deep per-account research, opt-in) -------------
# See app.services.account_research. Off by default, same rollout shape as
# MARKET_SCAN_ENABLED above — triggers (owner assignment, the explicit
# POST /companies/{id}/research action) are always safe to deploy first;
# nothing calls a real provider until this is true.
ACCOUNT_RESEARCH_ENABLED=false
ACCOUNT_RESEARCH_TTL_DAYS=30
ACCOUNT_RESEARCH_DAILY_BUDGET_PER_ORG=20

# ----- Federated Signal Intelligence -----------------------------------------
# See app.services.federated_intelligence. k-anonymity floor: a cross-tenant
# confidence prior is only returned once at least this many DISTINCT
# organizations have opted in AND contributed to the same (signal_type,
# industry) bucket — below it, nothing is shared or calibrated. Per-org
# opt-in itself (Organization.federated_intelligence_opt_in) lives in the
# database, not here — this only tunes the anonymity floor everyone shares.
# Keep the low pilot-cohort default while the fleet is small; raise it
# (e.g. to 15-20) once enough organizations have opted in that a higher
# floor still clears routinely.
FEDERATED_INTELLIGENCE_MIN_CONTRIBUTING_ORGS=3

# ----- Email engagement webhooks (SendGrid / Resend, opt-in) ----------------
# Inbound open/click/reply/bounce events, turned into DarkFunnelSignal rows
# via POST /api/v1/webhooks/receive. These sign BEE's OWN HMAC scheme, not
# SendGrid's/Resend's native signing — see that endpoint's docstring before
# wiring a real account. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# SENDGRID_WEBHOOK_SECRET=change-me-to-a-real-secret
# RESEND_WEBHOOK_SECRET=change-me-to-a-real-secret

# ----- CORS ------------------------------------------------------------------
# Comma-separated list of allowed browser origins (the Next.js frontend).
BACKEND_CORS_ORIGINS=http://localhost:3000

# Optional: matched IN ADDITION to BACKEND_CORS_ORIGINS above, whose match is
# exact-string only (see cors_origins' docstring in config.py). A Vercel
# project is reachable at several auto-generated aliases at once — for BEE's
# own apps/web (Vercel project "bee-web") that's at least its stable
# production alias, its git-branch alias, and a unique URL per deployment.
# Listing every one of those by hand in BACKEND_CORS_ORIGINS means the next
# alias Vercel generates is silently rejected by CORS until someone notices
# and adds it. This regex covers the whole "bee-web" family at once instead —
# uncomment it for BEE's production apps/web deployment specifically:
# BACKEND_CORS_ORIGIN_REGEX=^https://bee-web(-[a-zA-Z0-9]+)*\.vercel\.app$

# Canonical frontend origin (no trailing slash) — where a human gets
# redirected back to after an OAuth callback (e.g. Google) hands control
# back to us server-side. Set to your real deployed frontend URL in prod.
FRONTEND_URL=http://localhost:3000

# ----- Third-party OAuth token storage ---------------------------------------
# Symmetric key encrypting connected-account tokens (Gmail, and any future
# integration) before they're stored. Required before anyone can connect
# Gmail — leave unset otherwise. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# ----- Google OAuth (Gmail integration, /dashboard/integrations) ------------
# Powers the real "Connect Gmail" button — lets a rep send sequence steps
# from their own Gmail account. Create a Google Cloud OAuth 2.0 Client ID
# (Web application type), add GOOGLE_OAUTH_REDIRECT_URI below as an
# authorized redirect URI on it, and paste the Client ID/Secret it gives
# you. Leave all three unset to keep the button honestly showing
# "no disponible" instead of pretending to work.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Must exactly match a redirect URI registered on that OAuth Client, e.g.:
#   https://api.yourdomain.com/api/v1/integrations/gmail/callback
GOOGLE_OAUTH_REDIRECT_URI=

# ----- LinkedIn OAuth (LinkedIn integration, /dashboard/integrations) -------
# Powers the real "Connect LinkedIn" button — a per-organization connection,
# distinct from LINKEDIN_ACCESS_TOKEN and LINKEDIN_CLIENT_ID/SECRET below
# (those are a shared server credential and Sales Navigator enrichment,
# different products entirely). Create a "Sign In with LinkedIn using OpenID
# Connect" + "Share on LinkedIn" app at
# https://www.linkedin.com/developers/apps, add LINKEDIN_OAUTH_REDIRECT_URI
# below as an authorized redirect URL on it, and paste the Client ID/Secret
# it gives you.
LINKEDIN_OAUTH_CLIENT_ID=
LINKEDIN_OAUTH_CLIENT_SECRET=
# Must exactly match a redirect URL registered on that app, e.g.:
#   https://api.yourdomain.com/api/v1/integrations/linkedin/callback
LINKEDIN_OAUTH_REDIRECT_URI=

# ----- Salesforce OAuth (Salesforce integration, /dashboard/integrations) --
# Powers the real "Connect Salesforce" button. Create a Connected App in
# Salesforce Setup (App Manager → New Connected App → Enable OAuth
# Settings), add SALESFORCE_OAUTH_REDIRECT_URI below as a Callback URL on
# it, and paste the Consumer Key/Secret it gives you. Connecting is all
# this ships today — see app.services.integrations.salesforce_oauth for
# why actually syncing records isn't built yet (needs this org's real
# object/picklist schema, not just credentials).
SALESFORCE_OAUTH_CLIENT_ID=
SALESFORCE_OAUTH_CLIENT_SECRET=
# Must exactly match a Callback URL on that Connected App, e.g.:
#   https://api.yourdomain.com/api/v1/integrations/salesforce/callback
SALESFORCE_OAUTH_REDIRECT_URI=
# https://login.salesforce.com for production/Developer orgs (default),
# https://test.salesforce.com for a sandbox.
SALESFORCE_LOGIN_URL=https://login.salesforce.com

# ----- HubSpot OAuth (HubSpot integration, /dashboard/integrations) --------
# Powers the real "Connect HubSpot" button. Create a public app in your
# HubSpot Developer account (developers.hubspot.com → Apps → Create app),
# add HUBSPOT_OAUTH_REDIRECT_URI below as a Redirect URL on it, grant the
# crm.objects.companies.read / crm.objects.contacts.read /
# crm.objects.deals.read scopes, and paste the Client ID/Secret it gives
# you. Same one-way "connect + read import" shape as Salesforce, not a
# two-way sync — see app.services.integrations.hubspot_import.
HUBSPOT_OAUTH_CLIENT_ID=
HUBSPOT_OAUTH_CLIENT_SECRET=
# Must exactly match a Redirect URL on that app, e.g.:
#   https://api.yourdomain.com/api/v1/integrations/hubspot/callback
HUBSPOT_OAUTH_REDIRECT_URI=

# ----- Jira OAuth (Jira connector, /dashboard/integrations) -----------------
# Powers "Connect Jira" and the opportunity-stage sync it drives (see
# app.services.workflow_orchestrator.handlers.JiraSyncHandler). Create an
# OAuth 2.0 (3LO) app at developer.atlassian.com/console/myapps, add the
# Jira API with scopes read:jira-work / write:jira-work / offline_access,
# add JIRA_OAUTH_REDIRECT_URI below as a Callback URL, and paste the
# Client ID/Secret it gives you. After connecting from the dashboard, set
# a target Jira project key (PATCH /integrations/jira/config) — without
# one, JiraSyncHandler runs in mock mode.
JIRA_OAUTH_CLIENT_ID=
JIRA_OAUTH_CLIENT_SECRET=
# Must exactly match a Callback URL on that app, e.g.:
#   https://api.yourdomain.com/api/v1/integrations/jira/callback
JIRA_OAUTH_REDIRECT_URI=

# ----- ExecutiveAgent webhook (n8n / Zapier / Make) --------------------------
# When set, BEE fires a POST to this URL every time execution artifacts are
# generated. Leave empty to disable (no webhook sent).
WEBHOOK_EXECUTION_URL=

# ----- ResourcePredictorService (opt-in) -------------------------------------
# When enabled, BEE evaluates operational capacity before confirming WON.
# STRICT mode blocks confirmation when risk_level is HIGH.
RESOURCE_PREDICTION_ENABLED=false
RESOURCE_PREDICTION_STRICT=false

# ----- WorkflowOrchestrator webhooks (all opt-in) ----------------------------
# Set any of these to activate the corresponding workflow handler.
# Leave empty (or unset) to run in mock mode (full audit trail, no real calls).
WORKFLOW_CRM_URL=
WORKFLOW_DELIVERY_URL=
WORKFLOW_BILLING_URL=
WORKFLOW_NOTIFY_URL=

# ----- OmnichannelGateway — channel credentials (all opt-in) ----------------
# LinkedIn (REST API v2)
LINKEDIN_ACCESS_TOKEN=

# X / Twitter (API v2)
TWITTER_BEARER_TOKEN=
TWITTER_API_KEY=

# Email (SMTP)
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=

# ----- VectorKnowledgeBase (Sales DNA) ---------------------------------------
# Controls which vector store backend persists BEE's Sales DNA memory.
#
#   pgvector — persistent semantic search in PostgreSQL (default).
#              Requires: pgvector extension in your Postgres instance.
#              Run: `alembic upgrade head` to create the vector_embeddings table.
#              Run: `docker exec -it <pg-container> psql -U bee -c "CREATE EXTENSION vector"`
#              (see DEPLOY_CHECKLIST.md §3 for a managed-Postgres provider).
#              If init fails (missing extension, unreachable DB) the app
#              degrades to the mock store automatically rather than
#              refusing to start — GET /api/v1/status reports this
#              (checks.vector_store.status="error" with a fallback_reason)
#              so it's never a *silent* degradation in production.
#   mock     — in-memory TF-IDF; resets on restart, zero deps. Set this
#              explicitly for local dev without a pgvector-enabled
#              Postgres running.
#
# Embedding model (used by pgvector backend):
#   text-embedding-3-small: 1536 dims, ~$0.02/1M tokens — recommended
#   text-embedding-3-large: 3072 dims, higher quality, ~$0.13/1M tokens
#   (requires AI_PROVIDER=openai and AI_API_KEY to be set)
VECTOR_STORE_BACKEND=pgvector      # mock | pgvector
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ----- AI — LLM Backbone -----------------------------------------------------
# Set AI_PROVIDER and AI_API_KEY to enable LLM-based signal classification,
# strategy, and artifact generation (GPT-4o or Claude 3.5 Sonnet, Senior
# AE-quality output). Falls back to rule-based generators when AI_PROVIDER=none
# (zero cost, instant, always available).
#
# OpenAI (recommended — GPT-4o strategy + text-embedding-3-small for Sales DNA):
#   AI_PROVIDER=openai
#   AI_API_KEY=sk-...
#   AI_MODEL=gpt-4o-mini           # or gpt-4o for highest quality
#
# Anthropic (Claude 3.5 Sonnet — alternative provider):
#   AI_PROVIDER=anthropic
#   AI_API_KEY=sk-ant-...
#   ANTHROPIC_MODEL=claude-opus-5
AI_PROVIDER=none                   # none | openai | anthropic
AI_API_KEY=
AI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-opus-5
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2

# ----- External Ingestion Layer ----------------------------------------------
# Centralises LinkedIn, G2, Google Search connections with global rate limiting.
# Webhooks from external providers POST to /api/v1/webhooks/receive (HMAC auth).
EXTERNAL_INGESTION_ENABLED=true
EXTERNAL_WORKER_QUEUE_SIZE=1000

# LinkedIn Sales Navigator / REST API (profile enrichment)
# LINKEDIN_ACCESS_TOKEN is also used by OmnichannelGateway above.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_WEBHOOK_SECRET=

# G2 intent signals
G2_API_KEY=
G2_WEBHOOK_SECRET=

# Google Custom Search (company research)
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
GOOGLE_WEBHOOK_SECRET=

# Capterra (future)
CAPTERRA_API_KEY=
CAPTERRA_WEBHOOK_SECRET=
